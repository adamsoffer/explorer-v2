# Subgraph. Defaults to the Livepeer staging subgraph, which carries the
# delegator shares / snapshots / cumulative factors the portfolio needs.
# Set an explicit endpoint, or a Graph gateway key + subgraph id.
NEXT_PUBLIC_SUBGRAPH_ENDPOINT=
NEXT_PUBLIC_SUBGRAPH_API_KEY=
NEXT_PUBLIC_SUBGRAPH_ID=

# RPC. Public endpoints are used when these are empty.
NEXT_PUBLIC_INFURA_KEY=
NEXT_PUBLIC_L1_RPC_URL=
NEXT_PUBLIC_L2_RPC_URL=

NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Public URL of this deployment, e.g. https://explorer.livepeer.org. Used for
# absolute share-image URLs. Optional on Vercel when system environment
# variables are exposed; otherwise links preview without an image.
SITE_URL=

# Creating LIP polls: the explorer pins the LIP's text to IPFS through Pinata
# before the poll is created on-chain. Without it, poll creation is disabled.
PINATA_JWT=

# Optional: raises GitHub's rate limit when reading the LIPs repository.
GITHUB_ACCESS_TOKEN=

# Earnings CSV: USD prices at the time of each reward call, read on the
# server from CoinDesk Data / CryptoCompare (a free key from cryptocompare.com
# works). Without it, the export leaves the USD columns blank.
COINDESK_API_KEY=
